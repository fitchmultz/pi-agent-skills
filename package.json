{
  "name": "@fitch/pi-agent-skills",
  "version": "0.7.0",
  "private": true,
  "description": "Source-managed Pi skills for reusable agent workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-agent-skills.git"
  },
  "keywords": [
    "pi-package",
    "agent-skills"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node --test test/discovery.test.mjs",
    "check:compat": "npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "eval:model": "node evals/run.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
