{
  "name": "@fitch/pi-agent-skills",
  "version": "0.3.2",
  "private": true,
  "description": "Source-managed Pi skills for reusable agent workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-agent-skills.git"
  },
  "keywords": [
    "pi-package",
    "agent-skills"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test",
    "smoke": "PI_OFFLINE=1 pi --approve --no-context-files --no-prompt-templates --no-themes --no-extensions -e . --list-models __no_such_model__",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
